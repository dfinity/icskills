---
// BaseLayout: HTML shell. Emits everything trust/SEO-relevant:
// canonical link, description, Open Graph, Twitter card, JSON-LD.
// All pages go through this layout so meta tags are consistent.
import { SITE, absUrl } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  /** Path-only canonical (e.g. "/skills/motoko/"). Absolute URL derived from SITE.url. */
  canonicalPath: string;
  /** Optional: additional JSON-LD objects to inject as <script type="application/ld+json">. */
  jsonLd?: unknown[];
  /** Optional: ISO date for article-style pages (skill detail). */
  publishedTime?: string;
  modifiedTime?: string;
  /** og:type — "article" for skill pages, otherwise "website". */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonicalPath,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  ogType = 'website',
} = Astro.props;

const canonical = absUrl(canonicalPath);
const ogImage = absUrl('/og-image.svg');

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: {
    '@type': 'Organization',
    name: SITE.author.name,
    url: SITE.author.url,
  },
  license: SITE.license.url,
};

const allLd = [websiteLd, ...jsonLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="author" content={SITE.author.name} />
    <meta name="publisher" content={SITE.author.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Machine-readable mirrors -->
    <link rel="alternate" type="text/markdown" href={absUrl('/llms-full.txt')} title="All skills as markdown" />
    <link rel="alternate" type="application/rss+xml" href={absUrl('/feed.xml')} title={`${SITE.name} updates`} />
    <link rel="alternate" type="application/json" href={absUrl('/api/skills.json')} title="Skills index (JSON)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <!-- Fonts: serif headings + sans body -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
    />

    <!-- Structured data -->
    {allLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <header class="site-header" role="banner">
      <div class="container">
        <a href="/" class="brand" aria-label={`${SITE.name} home`}>
          <img class="brand-mark" src="/icp-logo.svg" alt="" width="26" height="26" />
          <span class="brand-name">{SITE.shortName}</span>
        </a>
        <nav aria-label="Primary">
          <a href="/">Browse</a>
          <a href="/how-it-works/">How it works</a>
          <a href="/get-started/">Get started</a>
          <a href={SITE.repo.url} rel="noopener external">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main" class="container" role="main">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="container">
        <p>
          <strong>{SITE.name}</strong> &mdash; maintained by
          <a href={SITE.author.url} rel="noopener external">{SITE.author.name}</a>.
          Source: <a href={SITE.repo.url} rel="noopener external">{SITE.repo.name}</a>
          &middot; Licensed <a href={SITE.license.url} rel="noopener external">{SITE.license.spdx}</a>.
        </p>
        <p class="machine-links">
          Machine-readable:
          <a href="/llms.txt">llms.txt</a> &middot;
          <a href="/llms-full.txt">llms-full.txt</a> &middot;
          <a href="/api/skills.json">skills.json</a> &middot;
          <a href="/sitemap-index.xml">sitemap</a> &middot;
          <a href="/feed.xml">RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>
