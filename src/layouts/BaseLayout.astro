---
// BaseLayout: HTML shell. Emits everything trust/SEO-relevant:
// canonical link, description, Open Graph, Twitter card, JSON-LD.
// All pages go through this layout so meta tags are consistent.
import { SITE, absUrl } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  /** Path-only canonical (e.g. "/skills/writing-motoko/"). Absolute URL derived from SITE.url. */
  canonicalPath: string;
  /** Optional: additional JSON-LD objects to inject as <script type="application/ld+json">. */
  jsonLd?: unknown[];
  /** Optional: ISO date for article-style pages (skill detail). */
  publishedTime?: string;
  modifiedTime?: string;
  /** og:type — "article" for skill pages, otherwise "website". */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonicalPath,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  ogType = 'website',
} = Astro.props;

const canonical = absUrl(canonicalPath);
const ogImage = absUrl('/og-image.png');

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: {
    '@type': 'Organization',
    name: SITE.author.name,
    url: SITE.author.url,
  },
  license: SITE.license.url,
};

const allLd = [websiteLd, ...jsonLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="author" content={SITE.author.name} />
    <meta name="publisher" content={SITE.author.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Machine-readable mirrors -->
    <link rel="alternate" type="text/markdown" href={absUrl('/llms-full.txt')} title="All skills as markdown" />
    <link rel="alternate" type="application/rss+xml" href={absUrl('/feed.xml')} title={`${SITE.name} updates`} />
    <link rel="alternate" type="application/json" href={absUrl('/api/skills.json')} title="Skills index (JSON)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <!-- Fonts: serif headings + sans body -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,wght@0,380;0,400;0,500;1,380;1,400;1,500&display=swap"
    />

    <!-- Structured data -->
    {allLd.map((obj) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <link rel="stylesheet" href="/styles.css" />
    <script is:inline src="/matomo.js" async></script>
    <!-- Set theme before first paint to prevent flash -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('icp-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <header class="site-header" role="banner">
      <div class="container">
        <a href="/" class="brand" aria-label={`${SITE.name} home`}>
          <img class="brand-mark" src="/icp-logo.svg" alt="" width="26" height="26" />
          <span class="brand-name">{SITE.shortName}</span>
        </a>
        <nav aria-label="Primary">
          <a href="/how-it-works/">How it works</a>
          <a href="/get-started/">Get started</a>
          <a href={SITE.repo.url} rel="noopener external" aria-label="GitHub" title="GitHub" style="display:inline-flex;align-items:center;">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <button id="theme-toggle" class="theme-toggle" aria-label="Switch to light mode" title="Toggle theme">
            <svg class="icon-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"/>
            </svg>
            <svg class="icon-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"/>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="container" role="main">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="container">
        <p>
          <strong>{SITE.name}</strong>, maintained by
          <a href={SITE.author.url} rel="noopener external">{SITE.author.name}</a>
          Source: <a href={SITE.repo.url} rel="noopener external">{SITE.repo.name}</a>
          Licensed <a href={SITE.license.url} rel="noopener external">{SITE.license.spdx}</a>
        </p>
        <p class="machine-links">
          Machine-readable:
          <a href="/llms.txt">llms.txt</a>
          <a href="/llms-full.txt">llms-full.txt</a>
          <a href="/api/skills.json">skills.json</a>
          <a href="/sitemap-index.xml">sitemap</a>
          <a href="/feed.xml">RSS</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      (function() {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        function sync(theme) {
          btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
        }
        sync(document.documentElement.getAttribute('data-theme') || 'dark');
        btn.addEventListener('click', function() {
          var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('icp-theme', next);
          sync(next);
        });
      })();
    </script>
  </body>
</html>
