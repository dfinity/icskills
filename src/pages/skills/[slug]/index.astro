---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, absUrl } from '../../../lib/site';
import {
  getAllSkills,
  getSkillUpdatedAt,
  githubUrl,
  skillUrl,
  type Skill,
} from '../../../lib/skills';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const skills = await getAllSkills();
  return skills.map((skill) => ({ params: { slug: skill.id }, props: { skill } }));
}

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const { Content } = await render(skill);

const updatedAt = await getSkillUpdatedAt(skill);
const mdPath = `/skills/${skill.id}.md`;
const jsonPath = `/api/skills/${skill.id}.json`;
const gh = githubUrl(skill.id);
const canonicalPath = skillUrl(skill.id);

const techArticleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: skill.data.metadata.title,
  name: skill.data.metadata.title,
  description: skill.data.description,
  url: absUrl(canonicalPath),
  mainEntityOfPage: absUrl(canonicalPath),
  inLanguage: SITE.locale,
  dateModified: updatedAt,
  articleSection: skill.data.metadata.category,
  keywords: [
    'Internet Computer',
    'ICP',
    'DFINITY',
    skill.data.metadata.category,
    skill.data.name,
  ].join(', '),
  author: {
    '@type': 'Organization',
    name: SITE.author.name,
    url: SITE.author.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.author.name,
    url: SITE.author.url,
  },
  license: SITE.license.url,
  isBasedOn: gh,
  sameAs: [gh],
  encoding: [
    { '@type': 'MediaObject', encodingFormat: 'text/html', contentUrl: absUrl(canonicalPath) },
    { '@type': 'MediaObject', encodingFormat: 'text/markdown', contentUrl: absUrl(mdPath) },
    { '@type': 'MediaObject', encodingFormat: 'application/json', contentUrl: absUrl(jsonPath) },
  ],
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Browse', item: SITE.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: skill.data.metadata.category,
      item: absUrl(`/#category-${encodeURIComponent(skill.data.metadata.category)}`),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: skill.data.metadata.title,
      item: absUrl(canonicalPath),
    },
  ],
};

const pageTitle = `${skill.data.metadata.title} — ${SITE.shortName}`;
---
<BaseLayout
  title={pageTitle}
  description={skill.data.description}
  canonicalPath={canonicalPath}
  jsonLd={[techArticleLd, breadcrumbLd]}
  ogType="article"
  modifiedTime={updatedAt}
>
  <article class="skill" itemscope itemtype="https://schema.org/TechArticle">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Browse</a>
      <span aria-hidden="true">&rsaquo;</span>
      <a href={`/#category-${encodeURIComponent(skill.data.metadata.category)}`}>
        {skill.data.metadata.category}
      </a>
      <span aria-hidden="true">&rsaquo;</span>
      <span itemprop="name">{skill.data.metadata.title}</span>
    </nav>

    <header class="skill-header">
      <p class="skill-category" itemprop="articleSection">{skill.data.metadata.category}</p>
      <h1 itemprop="headline">{skill.data.metadata.title}</h1>
      <p class="skill-description" itemprop="description">{skill.data.description}</p>

      <dl class="skill-meta">
        <div>
          <dt>Skill ID</dt>
          <dd><code>{skill.data.name}</code></dd>
        </div>
        <div>
          <dt>Category</dt>
          <dd>{skill.data.metadata.category}</dd>
        </div>
        {skill.data.license && (
          <div>
            <dt>License</dt>
            <dd>
              <a href={SITE.license.url} rel="noopener external">{skill.data.license}</a>
            </dd>
          </div>
        )}
        {skill.data.compatibility && (
          <div>
            <dt>Compatibility</dt>
            <dd><code>{skill.data.compatibility}</code></dd>
          </div>
        )}
        <div>
          <dt>Last updated</dt>
          <dd>
            <time datetime={updatedAt} itemprop="dateModified">
              {new Date(updatedAt).toISOString().slice(0, 10)}
            </time>
          </dd>
        </div>
        <div>
          <dt>Source</dt>
          <dd>
            <a href={gh} rel="noopener external" itemprop="isBasedOn">
              {SITE.repo.name}/skills/{skill.id}
            </a>
          </dd>
        </div>
      </dl>

      <nav class="skill-formats" aria-label="Alternative formats">
        <strong>Also available as:</strong>
        <ul>
          <li>
            <a href={mdPath} rel="alternate" type="text/markdown">Markdown</a>
          </li>
          <li>
            <a href={jsonPath} rel="alternate" type="application/json">JSON</a>
          </li>
        </ul>
      </nav>

      <p class="trust-banner" role="note">
        <strong>Trust note.</strong>
        This page is a static, pre-rendered mirror of
        <a href={gh} rel="noopener external">{SITE.repo.name}/skills/{skill.id}/SKILL.md</a>.
        The canonical source is the Git commit it was built from.
        Licensed {' '}
        <a href={SITE.license.url} rel="noopener external">{SITE.license.spdx}</a>.
      </p>
    </header>

    <div class="skill-body prose" itemprop="articleBody">
      <Content />
    </div>
  </article>
</BaseLayout>
