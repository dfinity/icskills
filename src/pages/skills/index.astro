---
import SiteLayout from "../../layouts/SiteLayout.astro";
import BrowseTab from "../../components/BrowseTab";
import { loadAllSkills } from "../../data/skills";
import { SITE_URL } from "../../data/site";

const skills = loadAllSkills();
const canonicalUrl = `${SITE_URL}/skills/`;

const itemListJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": skills.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${SITE_URL}/skills/${s.name}/`,
    "name": s.title,
  })),
});
---

<SiteLayout
  title="Browse Skills — Internet Computer (ICP) Skills"
  description="Browse all agent-readable skill files for the Internet Computer. ckBTC, Internet Identity, stable memory, HTTPS outcalls, EVM RPC, SNS, and more."
  canonicalUrl={canonicalUrl}
  ogTitle="Browse Skills — Internet Computer (ICP) Skills"
  ogDescription="Browse all agent-readable skill files for the Internet Computer. ckBTC, Internet Identity, stable memory, HTTPS outcalls, EVM RPC, SNS, and more."
  jsonLd={itemListJsonLd}
  activeTab="skills"
>
  <BrowseTab client:load skills={skills} />
</SiteLayout>
