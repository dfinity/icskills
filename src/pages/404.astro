---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
---
<BaseLayout
  title={`Not found — ${SITE.shortName}`}
  description="The page you requested was not found."
  canonicalPath="/404"
>
  <h1>Not found</h1>
  <p>
    That URL isn't part of this site. Try the <a href="/">skills index</a>, the
    machine-readable <a href="/llms.txt"><code>/llms.txt</code></a>, or the
    <a href="/api/skills.json"><code>/api/skills.json</code></a> API.
  </p>
</BaseLayout>
