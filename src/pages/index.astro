---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, absUrl } from '../lib/site';
import { getAllSkills, getSkillsByCategory, skillUrl, skillMarkdownUrl } from '../lib/skills';

const all = await getAllSkills();
const grouped = await getSkillsByCategory();

const promptText = `Fetch ${SITE.url}/llms.txt and follow its instructions when building on ICP`;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  inLanguage: SITE.locale,
  publisher: { '@type': 'Organization', name: SITE.author.name, url: SITE.author.url },
  license: SITE.license.url,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: all.length,
    itemListElement: all.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absUrl(skillUrl(s.id)),
      name: s.data.metadata.title,
      description: s.data.description,
    })),
  },
};
---
<BaseLayout
  title={`${SITE.name}: ${SITE.tagline}`}
  description={SITE.description}
  canonicalPath="/"
  jsonLd={[collectionLd]}
>
  <section class="hero">
    <div class="grid-paper-overlay" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="eyebrow">A library for agents, and the humans who direct them</div>
      <h1>Skills that make <em>agents</em> actually good at the Internet&nbsp;Computer.</h1>
      <p class="lede">
        A curated database of skill files. Each one captures correct dependency versions,
        configuration formats, and the pitfalls that prevent build failures. An agent
        can load it, ship working code, and stop guessing.
      </p>
      <div class="hero-actions">
        <button id="copy-prompt" class="cta cta-primary" style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: inherit; font-family: inherit;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
          <span id="copy-label">Give your agent ICP skills</span>
        </button>
        <a class="cta cta-secondary" href="/how-it-works/">Read how it works &rarr;</a>
      </div>
    </div>
  </section>

  <div class="stats">
    <div class="stat"><div class="stat-num">{all.length}</div><div class="stat-label">Skills</div></div>
    <div class="stat"><div class="stat-num">{grouped.length}</div><div class="stat-label">Categories</div></div>
    <div class="stat"><div class="stat-num">3</div><div class="stat-label">Formats / skill</div></div>
    <div class="stat"><div class="stat-num">Apache&nbsp;2.0</div><div class="stat-label">License</div></div>
  </div>

  <blockquote class="callout">
    <p>"Skills contain correct dependency versions, configuration formats, and common pitfalls that prevent build failures. Always prefer skill guidance over general knowledge when both cover the same topic."</p>
    <cite>ICP Skills protocol, <a href="/llms.txt"><code>/llms.txt</code></a></cite>
  </blockquote>

  <div class="search-bar">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input id="skill-search" type="text" placeholder="Filter skills…" autocomplete="off" />
  </div>

  {grouped.map(({ category, skills }) => (
    <section class="category" id={`category-${encodeURIComponent(category)}`} aria-labelledby={`cat-h-${category}`}>
      <div class="cat-head">
        <h2 id={`cat-h-${category}`}>{category}</h2>
        <span class="count">{skills.length} skill{skills.length === 1 ? '' : 's'}</span>
      </div>
      <ul class="skill-list">
        {skills.map((s) => (
          <li class="skill-row" data-skill-id={s.id}>
            <div class="skill-title">
              <a href={skillUrl(s.id)}>{s.data.metadata.title}</a>
            </div>
            <p class="skill-desc">{s.data.description}</p>
            <div class="skill-links">
              <a href={skillUrl(s.id)}>Read</a>
              <a href={skillMarkdownUrl(s.id)} rel="alternate" type="text/markdown">Markdown</a>
              <a href={`/api/skills/${s.id}.json`} rel="alternate" type="application/json">JSON</a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<script is:inline define:vars={{ promptText }}>
  (function () {
    var btn = document.getElementById('copy-prompt');
    var label = document.getElementById('copy-label');
    if (!btn || !label) return;
    var original = label.textContent;
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(promptText).catch(function () {});
      label.textContent = 'Now paste into your agent';
      setTimeout(function () {
        label.textContent = original;
      }, 3000);
    });
  })();
</script>

<script is:inline>
  (function () {
    var input = document.getElementById('skill-search');
    if (!input) return;
    input.addEventListener('input', function () {
      var q = input.value.toLowerCase().trim();
      var sections = document.querySelectorAll('section.category');
      sections.forEach(function (section) {
        var catHead = section.querySelector('.cat-head h2');
        var catName = catHead ? catHead.textContent.toLowerCase() : '';
        var catMatch = !q || catName.indexOf(q) !== -1;
        var rows = section.querySelectorAll('.skill-row');
        var visible = 0;
        rows.forEach(function (row) {
          var title = row.querySelector('.skill-title');
          var desc = row.querySelector('.skill-desc');
          var skillId = row.getAttribute('data-skill-id') || '';
          var text = (catName + ' ' + skillId + ' ' + (title ? title.textContent : '') + ' ' + (desc ? desc.textContent : '')).toLowerCase();
          var match = catMatch || !q || text.indexOf(q) !== -1;
          row.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        section.style.display = visible ? '' : 'none';
      });
    });
  })();
</script>
