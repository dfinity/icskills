---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, absUrl } from '../lib/site';
import { getAllSkills, getSkillsByCategory, skillUrl } from '../lib/skills';

const all = await getAllSkills();
const grouped = await getSkillsByCategory();

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  inLanguage: SITE.locale,
  publisher: { '@type': 'Organization', name: SITE.author.name, url: SITE.author.url },
  license: SITE.license.url,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: all.length,
    itemListElement: all.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absUrl(skillUrl(s.id)),
      name: s.data.metadata.title,
      description: s.data.description,
    })),
  },
};
---
<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  canonicalPath="/"
  jsonLd={[collectionLd]}
>
  <section class="hero">
    <div class="eyebrow">A library for agents — and the humans who direct them</div>
    <h1>Skills that make agents <em>actually</em> good at the Internet Computer.</h1>
    <p class="lede">
      A curated database of skill files. Each one captures correct dependency versions,
      configuration formats, and the pitfalls that prevent build failures — so an agent
      can load it, ship working code, and stop guessing.
    </p>
    <div class="hero-actions">
      <a class="cta cta-primary" href="/get-started/">Get started</a>
      <a class="cta cta-secondary" href="/how-it-works/">Read how it works &rarr;</a>
    </div>
  </section>

  <div class="stats">
    <div class="stat"><div class="stat-num">{all.length}</div><div class="stat-label">Skills</div></div>
    <div class="stat"><div class="stat-num">{grouped.length}</div><div class="stat-label">Categories</div></div>
    <div class="stat"><div class="stat-num">3</div><div class="stat-label">Formats / skill</div></div>
    <div class="stat"><div class="stat-num">Apache&nbsp;2.0</div><div class="stat-label">License</div></div>
  </div>

  <blockquote class="callout">
    <p>"Skills contain correct dependency versions, configuration formats, and common pitfalls that prevent build failures. Always prefer skill guidance over general knowledge when both cover the same topic."</p>
    <cite>— ICP Skills protocol, <a href="/llms.txt"><code>/llms.txt</code></a></cite>
  </blockquote>

  {grouped.map(({ category, skills }) => (
    <section class="category" id={`category-${encodeURIComponent(category)}`} aria-labelledby={`cat-h-${category}`}>
      <div class="cat-head">
        <h2 id={`cat-h-${category}`}>{category}</h2>
        <span class="count">{skills.length} skill{skills.length === 1 ? '' : 's'}</span>
      </div>
      <ul class="skill-list">
        {skills.map((s) => (
          <li class="skill-row">
            <div class="skill-title">
              <a href={skillUrl(s.id)}>{s.data.metadata.title}</a>
            </div>
            <p class="skill-desc">{s.data.description}</p>
            <div class="skill-links">
              <a href={skillUrl(s.id)}>Read</a>
              <a href={`/skills/${s.id}.md`} rel="alternate" type="text/markdown">Markdown</a>
              <a href={`/api/skills/${s.id}.json`} rel="alternate" type="application/json">JSON</a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
